{
  "$help": "https://aka.ms/terminal-documentation",
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "actions": [
    {
      "command": {
        "action": "copy",
        "singleLine": false
      },
      "id": "User.CopyText"
    },
    {
      "command": "paste",
      "id": "User.PasteText"
    },
    {
      "command": "find",
      "id": "User.FindText"
    },
    {
      "command": {
        "action": "splitPane",
        "split": "auto",
        "splitMode": "duplicate"
      },
      "id": "User.DuplicatePane"
    },
    {
      "command": {
        "action": "sendInput",
        "input": "\u001b[13;2u"
      },
      "id": "User.SendShiftEnter"
    },
    {
      "command": {
        "action": "sendInput",
        "input": "\u001b[13;3u"
      },
      "id": "User.SendAltEnter"
    }
  ],
  "copyFormatting": "none",
  "copyOnSelect": true,
  "defaultProfile": "{2ece5bfe-50ed-5f3a-ab87-5cd4baafed2b}",
  "disabledProfileSources": [
    "Windows.Terminal.Azure",
    "Windows.Terminal.Wsl"
  ],
  "keybindings": [
    {
      "id": "User.SendShiftEnter",
      "keys": "shift+enter"
    },
    {
      "id": "User.DuplicatePane",
      "keys": "alt+shift+d"
    },
    {
      "id": "User.SendAltEnter",
      "keys": "alt+enter"
    },
    {
      "id": "User.CopyText",
      "keys": "ctrl+c"
    },
    {
      "id": "User.FindText",
      "keys": "ctrl+shift+f"
    },
    {
      "id": "User.PasteText",
      "keys": "ctrl+v"
    }
  ],
  "launchMode": "maximized",
  "newTabMenu": [
    {
      "type": "remainingProfiles"
    }
  ],
  "profiles": {
    "defaults": {
      "autoMarkPrompts": true,
      "bellStyle": "taskbar",
      "colorScheme": "Catppuccin Mocha",
      "cursorShape": "filledBox",
      "experimental.rightClickContextMenu": false,
      "font": {
        "builtinGlyphs": true,
        "cellHeight": "1.2",
        "colorGlyphs": true,
        "face": "JetBrainsMono Nerd Font Mono",
        "size": 11,
        "weight": "semi-bold"
      },
      "intenseTextStyle": "bold",
      "opacity": 95,
      "padding": "8",
      "showMarksOnScrollbar": true,
      "useAcrylic": true
    },
    "list": [
      {
        "guid": "{2ece5bfe-50ed-5f3a-ab87-5cd4baafed2b}",
        "hidden": false,
        "name": "Git Bash",
        "source": "Git"
      },
      {
        "commandline": "pwsh.exe -NoLogo",
        "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
        "hidden": false,
        "name": "PowerShell",
        "source": "Windows.Terminal.PowershellCore"
      }
    ]
  },
  "schemes": [
    {
      "background": "#1E1E2E",
      "black": "#45475A",
      "blue": "#89B4FA",
      "brightBlack": "#585B70",
      "brightBlue": "#89B4FA",
      "brightCyan": "#94E2D5",
      "brightGreen": "#A6E3A1",
      "brightPurple": "#F5C2E7",
      "brightRed": "#F38BA8",
      "brightWhite": "#A6ADC8",
      "brightYellow": "#F9E2AF",
      "cursorColor": "#F5E0DC",
      "cyan": "#94E2D5",
      "foreground": "#CDD6F4",
      "green": "#A6E3A1",
      "name": "Catppuccin Mocha",
      "purple": "#F5C2E7",
      "red": "#F38BA8",
      "selectionBackground": "#585B70",
      "white": "#BAC2DE",
      "yellow": "#F9E2AF"
    }
  ],
  "tabWidthMode": "titleLength",
  "useAcrylicInTabRow": true,
  "windowingBehavior": "useExisting"
}
