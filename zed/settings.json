// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "auto_install_extensions": {
    "astro": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "dockerfile": true,
    "git-firefly": true,
    "html": true,
    "java": true,
    "latex": true,
    "log": true,
    "make": true,
    "powershell": true,
    "sql": true,
    "terraform": true,
    "toml": true,
    "xml": true,
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
    "sort_by_path": true
  },
  "title_bar": {
    "show_user_picture": true,
    "show_project_items": true,
    "show_branch_name": true,
    "show_branch_icon": true,
    "show_sign_in": false,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 0,
    },
  },
  "agent": {
    "enabled": false,
    "button": false,
    "dock": "left",
    "model_parameters": [],
  },
  "project_panel": {
    "dock": "right",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "base_keymap": "JetBrains",
  "features": {
    "edit_prediction_provider": "none",
  },
  "show_edit_predictions": false,
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "buffer_font_family": "JetBrains Mono",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
  // Cursor and scrolling
  "cursor_blink": true,
  "scroll_beyond_last_line": "one_page",
  "vertical_scroll_margin": 3,
  "terminal": {
    "font_family": "JetBrains Mono",
    "font_size": 14,
    "line_height": "comfortable",
    "blinking": "terminal_controlled",
    "alternate_scroll": "on",
    "option_as_meta": false,
    "copy_on_select": true,
  },
  // File finding
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/venv",
    "**/.venv",
    "**/node_modules",
    "**/__pycache__",
    "**/.ruff_cache",
    "**/target",
    "**/dist",
    "**/build",
  ],
  // Performance
  "restore_on_startup": "last_workspace",
  "show_completion_documentation": true,
  "show_completions_on_input": true,
  "use_on_type_format": true,
  "soft_wrap": "editor_width",
  "show_wrap_guides": false,
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
  },
  "always_treat_brackets_as_autoclosed": true,
  "use_autoclose": true,
  "auto_update": true,
  "disable_ai": true,
  "tab_size": 4,
  "languages": {
    "Python": {
      "formatter": {
        "external": {
          "command": "ruff",
          "arguments": ["format", "-"]
        }
      },
      "format_on_save": "on"
    },
    "JavaScript": {
      "hard_tabs": true,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--use-tabs", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "TypeScript": {
      "hard_tabs": true,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--use-tabs", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "TSX": {
      "hard_tabs": true,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--use-tabs", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "JSX": {
      "hard_tabs": true,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--use-tabs", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "HTML": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "CSS": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "Markdown": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "TOML": {
      "formatter": "language_server",
      "format_on_save": "on"
    },
    "YAML": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "JSON": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "JSONC": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "Java": {
      "formatter": {
        "external": {
          "command": "google-java-format",
          "arguments": ["-"]
        }
      },
      "format_on_save": "on"
    }
  }
}
